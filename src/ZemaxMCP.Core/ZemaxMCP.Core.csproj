<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>ZemaxMCP.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="MathNet.Numerics" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <!-- Zemax ZOS-API References -->
    <Reference Include="ZOSAPI">
      <HintPath>$(ZOSAPI_PATH)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ZOSAPI_Interfaces">
      <HintPath>$(ZOSAPI_INTERFACES_PATH)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ZOSAPI_NetHelper">
      <HintPath>$(ZOSAPI_NETHELPER_PATH)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
