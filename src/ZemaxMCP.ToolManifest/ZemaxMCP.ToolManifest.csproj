<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>ZemaxMCP.ToolManifest</RootNamespace>
    <GeneratedManifestFile>$(MSBuildProjectDirectory)\obj\$(Configuration)\$(TargetFramework)\GeneratedToolManifest.g.cs</GeneratedManifestFile>
    <ToolSourceRoot>$(MSBuildThisFileDirectory)..\ZemaxMCP.Server\Tools</ToolSourceRoot>
    <ManifestGeneratorProject>$(MSBuildThisFileDirectory)..\..\tools\ZemaxMCP.ToolManifestGenerator\ZemaxMCP.ToolManifestGenerator.csproj</ManifestGeneratorProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Text.Json" />
    <Compile Include="..\ZemaxMCP.Toolsets\ToolsetCatalog.cs" Link="Toolsets\ToolsetCatalog.cs" />
    <Compile Include="$(GeneratedManifestFile)" Visible="false" />
  </ItemGroup>
  <!-- Always regenerate before compilation. Timestamp-only incremental inputs
       cannot detect a deleted tool source file and could otherwise preserve a
       stale command in the public manifest until a clean build. -->
  <Target Name="GenerateStaticToolManifest" BeforeTargets="CoreCompile">
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(GeneratedManifestFile)'))" />
    <Exec Command="dotnet run --project &quot;$(ManifestGeneratorProject)&quot; --configuration $(Configuration) --no-launch-profile -- &quot;$(ToolSourceRoot)&quot; &quot;$(GeneratedManifestFile)&quot;" />
  </Target>
</Project>
