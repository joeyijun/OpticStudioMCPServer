<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>ZemaxMCP.ToolManifest</RootNamespace>
    <GeneratedManifestFile>$(IntermediateOutputPath)GeneratedToolManifest.g.cs</GeneratedManifestFile>
    <ToolSourceRoot>$(MSBuildThisFileDirectory)..\ZemaxMCP.Server\Tools</ToolSourceRoot>
    <ManifestGeneratorProject>$(MSBuildThisFileDirectory)..\..\tools\ZemaxMCP.ToolManifestGenerator\ZemaxMCP.ToolManifestGenerator.csproj</ManifestGeneratorProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Text.Json" />
    <ToolManifestSource Include="$(ToolSourceRoot)\**\*.cs" />
    <ToolManifestGeneratorSource Include="$(MSBuildThisFileDirectory)..\..\tools\ZemaxMCP.ToolManifestGenerator\**\*.cs" />
    <ToolManifestGeneratorSource Include="$(ManifestGeneratorProject)" />
    <Compile Include="$(GeneratedManifestFile)" Visible="false" />
  </ItemGroup>
  <Target Name="GenerateStaticToolManifest"
          BeforeTargets="CoreCompile"
          Inputs="@(ToolManifestSource);@(ToolManifestGeneratorSource)"
          Outputs="$(GeneratedManifestFile)">
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(GeneratedManifestFile)'))" />
    <Exec Command="dotnet run --project &quot;$(ManifestGeneratorProject)&quot; --configuration $(Configuration) --no-launch-profile -- &quot;$(ToolSourceRoot)&quot; &quot;$(GeneratedManifestFile)&quot;" />
  </Target>
</Project>
