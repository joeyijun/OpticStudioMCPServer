<Window x:Class="ZemaxMCP.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zemax MCP Setup" Icon="Assets/ZemaxMCP.ico"
        Width="1040" Height="860" MinWidth="860" MinHeight="660"
        WindowStartupLocation="CenterScreen" Loaded="OnLoaded"
        Background="{DynamicResource WorkspaceSurface}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
  <Window.Resources>
    <!-- Native DWM provides the window backdrop; this brush is the startup/offline-preview fallback. -->
    <LinearGradientBrush x:Key="WorkspaceSurface" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#E5EDF8" Offset="0"/>
      <GradientStop Color="#F0EFF7" Offset="0.45"/>
      <GradientStop Color="#EAF2F3" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassSurface" StartPoint="0,0" EndPoint="0.65,1">
      <GradientStop Color="#DEFFFFFF" Offset="0"/>
      <GradientStop Color="#BFFFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassEdge" StartPoint="0,0" EndPoint="0.4,1">
      <GradientStop Color="#FFFFFF" Offset="0"/>
      <GradientStop Color="#B8C9D5E4" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ControlSurface" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#FCFFFFFF" Offset="0"/>
      <GradientStop Color="#E6EDF1F7" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="HeadingBrush" Color="#1D1D1F"/>
    <SolidColorBrush x:Key="BodyBrush" Color="#454549"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#6E6E73"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#006ADC"/>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource GlassSurface}"/>
      <Setter Property="BorderBrush" Value="{StaticResource GlassEdge}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="18"/>
      <Setter Property="Padding" Value="22"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Effect">
        <Setter.Value><DropShadowEffect Color="#526585" BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.08"/></Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="InputBox" TargetType="TextBox">
      <Setter Property="Height" Value="38"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="Background" Value="#F5F5F7"/>
      <Setter Property="Foreground" Value="{StaticResource HeadingBrush}"/>
      <Setter Property="BorderBrush" Value="#DEDEE3"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="InputChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
              <ScrollViewer x:Name="PART_ContentHost"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="InputChrome" Property="Opacity" Value="0.55"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PasswordInputBox" TargetType="PasswordBox">
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="Background" Value="#FBFCFE"/>
      <Setter Property="Foreground" Value="{StaticResource HeadingBrush}"/>
      <Setter Property="BorderBrush" Value="#DEDEE3"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="Background" Value="#FBFCFE"/>
      <Setter Property="Foreground" Value="{StaticResource HeadingBrush}"/>
      <Setter Property="BorderBrush" Value="#DEDEE3"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="ComboChrome" Background="#F5F5F7" BorderBrush="#DEDEE3" BorderThickness="1" CornerRadius="6">
                      <Path Data="M 0 0 L 4 4 L 8 0" Stroke="#6E6E73" StrokeThickness="1.5"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboChrome" Property="BorderBrush" Value="#006ADC"/></Trigger>
                      <Trigger Property="IsChecked" Value="True"><Setter TargetName="ComboChrome" Property="BorderBrush" Value="#006ADC"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter Margin="11,0,32,0" VerticalAlignment="Center" IsHitTestVisible="False" ClipToBounds="True"
                                Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
              <Border x:Name="ComboFocus" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" IsHitTestVisible="False"/>
              <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                     AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                <Border Background="White" BorderBrush="#DEDEE3" BorderThickness="1" CornerRadius="7" Padding="4" Margin="0,4,0,0"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                  <ScrollViewer MaxHeight="280" CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboFocus" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
      <Setter Property="Padding" Value="9,7"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource BodyBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent" MinHeight="24">
              <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border x:Name="SwitchTrack" Width="34" Height="20" CornerRadius="10" Background="#D2D2D7"
                      HorizontalAlignment="Left" VerticalAlignment="Center" BorderThickness="1" BorderBrush="Transparent">
                <Ellipse x:Name="SwitchThumb" Width="16" Height="16" Fill="White" Margin="1,0" HorizontalAlignment="Left"/>
              </Border>
              <ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="SwitchTrack" Property="Background" Value="{StaticResource AccentBrush}"/>
                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{StaticResource HeadingBrush}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ActionButton" TargetType="Button">
      <Setter Property="Height" Value="36"/>
      <Setter Property="MinWidth" Value="84"/>
      <Setter Property="Padding" Value="14,6"/>
      <Setter Property="Background" Value="{StaticResource ControlSurface}"/>
      <Setter Property="Foreground" Value="#343438"/>
      <Setter Property="BorderBrush" Value="#DEDEE3"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonChrome" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="9" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonChrome" Property="Opacity" Value="0.88"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonChrome" Property="Opacity" Value="0.72"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#1D1D1F"/><Setter TargetName="ButtonChrome" Property="BorderThickness" Value="2"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonChrome" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
      <Setter Property="Height" Value="32"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Padding" Value="11,4"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
      <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
      <Setter Property="MinWidth" Value="108"/>
    </Style>

    <Style x:Key="StopButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
      <Setter Property="Background" Value="#F0F0F3"/>
      <Setter Property="Foreground" Value="#454549"/>
      <Setter Property="BorderBrush" Value="#E7E7EB"/>
      <Setter Property="MinWidth" Value="96"/>
    </Style>

    <Style x:Key="ExitButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
      <Setter Property="Height" Value="38"/>
      <Setter Property="MinWidth" Value="112"/>
      <Setter Property="Padding" Value="17,7"/>
      <Setter Property="Background" Value="#FFF0EF"/>
      <Setter Property="Foreground" Value="#BA3028"/>
      <Setter Property="BorderBrush" Value="#F1D6D3"/>
    </Style>

    <Style x:Key="SectionLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource HeadingBrush}"/>
      <Setter Property="Margin" Value="0,0,0,9"/>
    </Style>

    <Style x:Key="StatusHeading" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource HeadingBrush}"/>
    </Style>

    <Style x:Key="HelperText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="LineHeight" Value="18"/>
    </Style>

    <Style x:Key="ClientMenuItem" TargetType="MenuItem">
      <Setter Property="Height" Value="38"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Margin" Value="5,1"/>
      <Setter Property="Foreground" Value="{StaticResource HeadingBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Border x:Name="MenuItemChrome" Background="{TemplateBinding Background}" CornerRadius="6"
                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <ContentControl Content="{TemplateBinding Icon}" Width="10" Height="10"
                                HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center"
                                  RecognizesAccessKey="True"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="MenuItemChrome" Property="Background" Value="#EDF5FC"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="MenuItemChrome" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ClientStatusText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Margin" Value="12,0,0,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Text" Value="Not detected"/>
    </Style>
  </Window.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="28,20,28,24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
          <TextBlock Text="Zemax MCP" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource HeadingBrush}"/>
          <TextBlock x:Name="LastStatusCheck" Text="Checking service…" Foreground="{StaticResource MutedBrush}" FontSize="11.5" Margin="1,4,0,0"
                     ToolTip="Updates automatically: AI activity every second; service health every 5 seconds. This timestamp records the last health check, not a software update."/>
        </StackPanel>
        <Border Grid.Column="1" Style="{StaticResource Card}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="6" CornerRadius="16">
        <StackPanel Orientation="Horizontal">
          <Button Content="Start" Style="{StaticResource PrimaryButton}" MinWidth="76" Height="34" Padding="10,5" Margin="0,0,7,0"
                  ToolTip="Start the local MCP service" Click="Start_Click"/>
          <Button Content="Stop" Style="{StaticResource StopButton}" MinWidth="70" Height="34" Padding="10,5" Margin="0,0,7,0"
                  ToolTip="Stop the local MCP service" Click="Stop_Click"/>
          <Button Content="Refresh" Style="{StaticResource ActionButton}" MinWidth="74" Height="34" Padding="10,5" Margin="0,0,7,0"
                  ToolTip="Refresh live service status" Click="RefreshStatus_Click"/>
          <Button Content="Test MCP" Style="{StaticResource ActionButton}" MinWidth="80" Height="34" Padding="10,5" Margin="0,0,9,0"
                  ToolTip="Test the currently selected MCP endpoint" Click="TestMcp_Click"/>
          <Button Content="Exit service" Style="{StaticResource ExitButton}" VerticalAlignment="Center"
                  ToolTip="Stop the MCP service and close the launcher" Click="Exit_Click"/>
        </StackPanel>
        </Border>
      </Grid>

      <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,16,0,0">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="OpticStudio installation" Style="{StaticResource SectionLabel}"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <ComboBox x:Name="ZemaxVersions" DisplayMemberPath="DisplayName" SelectionChanged="ZemaxVersions_SelectionChanged"/>
              <Button Grid.Column="1" Content="Browse…" Style="{StaticResource ActionButton}" MinWidth="80" Margin="8,0,0,0"
                      ToolTip="Select a custom OpticStudio installation folder" Click="ChooseZemaxFolder_Click"/>
            </Grid>
            <CheckBox x:Name="StartOnLogin" Content="Start Zemax MCP when I sign in" Margin="1,11,0,0"
                      Checked="StartOnLogin_Changed" Unchecked="StartOnLogin_Changed"/>
            <StackPanel Margin="0,12,0,0">
              <TextBlock Text="Run configuration" Style="{StaticResource HelperText}" Margin="0,0,0,5"/>
              <ComboBox x:Name="ToolsetProfile" SelectedIndex="4" SelectionChanged="ToolsetProfile_SelectionChanged"
                        ToolTip="Controls which task-oriented MCP tool domains are exposed to AI clients.">
                <ComboBoxItem Tag="basic-viewing">View &amp; analyze</ComboBoxItem>
                <ComboBoxItem Tag="sequential-design">Sequential design</ComboBoxItem>
                <ComboBoxItem Tag="nonsequential-stray-light">Non-sequential &amp; stray light</ComboBoxItem>
                <ComboBoxItem Tag="optimization-tolerance">Optimization &amp; tolerancing</ComboBoxItem>
                <ComboBoxItem Tag="full-expert">Full expert</ComboBoxItem>
              </ComboBox>
            </StackPanel>
          </StackPanel>
          <Border Grid.Column="1" Width="1" Background="#E8EDF4" Margin="0,2"/>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Network access" Style="{StaticResource SectionLabel}"/>
            <CheckBox x:Name="ShareOnLan" Content="Share with a trusted LAN computer"
                      Checked="ShareOnLan_Changed" Unchecked="ShareOnLan_Changed"/>
            <CheckBox x:Name="ReadOnlyMode" Content="Read-only mode (block lens changes)" Margin="0,8,0,0"
                      Checked="ReadOnlyMode_Changed" Unchecked="ReadOnlyMode_Changed"/>
            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="Port" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
              <TextBox Grid.Column="1" x:Name="Port" Text="8000" Style="{StaticResource InputBox}" Margin="10,0,0,0"
                       LostFocus="Port_LostFocus"/>
              <Button Grid.Column="2" Content="New token" Style="{StaticResource SmallButton}" HorizontalAlignment="Right" Click="RegenerateToken_Click"/>
            </Grid>
            <Button Content="Copy secure setup" Style="{StaticResource ActionButton}" HorizontalAlignment="Stretch" Margin="0,10,0,0" Click="CopySecureSetup_Click"/>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="3" Margin="0,16,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="This computer" Style="{StaticResource SectionLabel}"/>
            <TextBlock Text="Local service address" Style="{StaticResource HelperText}" Margin="0,0,0,8"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox x:Name="Endpoint" IsReadOnly="True" Style="{StaticResource InputBox}" FontFamily="Consolas" FontSize="12"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
              <Button Grid.Column="1" Content="Copy" Style="{StaticResource ActionButton}" MinWidth="70" Margin="9,0,0,0" Click="CopyEndpoint_Click"/>
            </Grid>
            <TextBlock Text="Use Copy secure setup to connect another computer." Style="{StaticResource HelperText}" Margin="0,10,0,0"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="AI computer" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
            <Border Background="#F5F5F7" BorderBrush="#E8E8ED" BorderThickness="1" CornerRadius="7" Padding="9,6" Margin="0,0,0,8">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Ellipse x:Name="RemoteSetupDot" Width="9" Height="9" Fill="#94A3B8" Margin="0,3,8,0" VerticalAlignment="Top"/>
                <TextBlock Grid.Column="1" x:Name="RemoteSetupStatus" Foreground="{StaticResource MutedBrush}" FontSize="12"
                           TextWrapping="Wrap" ToolTip="The remote endpoint and access token are encrypted for this Windows user."/>
              </Grid>
            </Border>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox x:Name="RemoteSecureSetup" Style="{StaticResource InputBox}"
                       ToolTip="Paste the complete secure setup JSON copied from the OpticStudio computer. It is stored securely after validation."
                       LostFocus="RemoteSecureSetup_LostFocus"/>
              <Button Grid.Column="1" Content="Use local" Style="{StaticResource SmallButton}" Margin="9,2,0,2"
                      ToolTip="Use this computer's local MCP service again" Click="ClearRemoteSetup_Click"/>
            </Grid>
            <TextBlock Text="Paste secure setup from the OpticStudio computer." Style="{StaticResource HelperText}" Margin="1,8,0,0"/>
          </StackPanel>
        </Border>
      </Grid>

      <Grid Grid.Row="1" Margin="0,20,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1.25*"/>
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" MinHeight="152">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Ellipse x:Name="McpStateDot" Width="12" Height="12" Fill="#94A3B8" Margin="0,3,10,0" VerticalAlignment="Top"/>
            <StackPanel Grid.Column="1">
              <TextBlock Text="MCP service" Style="{StaticResource StatusHeading}"/>
              <TextBlock x:Name="McpState" Text="Not checked" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Grid>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Card}" MinHeight="148">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Ellipse x:Name="ZosStateDot" Width="12" Height="12" Fill="#94A3B8" Margin="0,3,10,0" VerticalAlignment="Top"/>
            <StackPanel Grid.Column="1">
              <TextBlock Text="OpticStudio / ZOS-API" Style="{StaticResource StatusHeading}" TextWrapping="Wrap"/>
              <TextBlock x:Name="ZosState" Text="Not checked" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Grid>
        </Border>
        <Grid Grid.Column="4" Margin="0">
        <Border Style="{StaticResource Card}" MinHeight="148">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="AiStateDot" Width="12" Height="12" Fill="#94A3B8" Margin="0,3,9,0" VerticalAlignment="Top"/>
                <TextBlock Text="AI client setup" Style="{StaticResource StatusHeading}"/>
              </StackPanel>
              <TextBlock x:Name="AiState" Text="Not checked" Foreground="{StaticResource MutedBrush}"
                         Margin="21,6,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Height="54" LineHeight="18"
                         ToolTip="{Binding Text, ElementName=AiState}"/>
            </StackPanel>
            <Button Grid.Row="1" x:Name="AiConfigButton" Content="Configure clients ▾" Style="{StaticResource ActionButton}"
                    MinWidth="138" Margin="21,10,0,0" HorizontalAlignment="Left" Click="AiConfigMenu_Click">
              <Button.ContextMenu>
                <ContextMenu x:Name="AiClientsMenu" MinWidth="330" Padding="0,6"
                             Background="#FFFFFF" BorderBrush="#CBD7E5" BorderThickness="1"
                             FontFamily="Segoe UI" HasDropShadow="True">
                  <ContextMenu.Template>
                    <ControlTemplate TargetType="ContextMenu">
                      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"
                              Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                      </Border>
                    </ControlTemplate>
                  </ContextMenu.Template>
                  <MenuItem Style="{StaticResource ClientMenuItem}" Click="ConfigureDetected_Click">
                    <MenuItem.Header>
                      <Grid Width="280">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Configure detected clients" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Background="#E7F1FB" CornerRadius="9" Padding="8,2">
                          <TextBlock Text="Set up all" Foreground="#155A91" FontSize="11.5"/>
                        </Border>
                      </Grid>
                    </MenuItem.Header>
                  </MenuItem>
                  <Separator Margin="8,5" Background="#E2E8F0"/>
                  <MenuItem Style="{StaticResource ClientMenuItem}" Click="Codex_Click">
                    <MenuItem.Icon><Ellipse x:Name="CodexConfigDot" Width="9" Height="9" Fill="#94A3B8"/></MenuItem.Icon>
                    <MenuItem.Header><Grid Width="252"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Codex"/><TextBlock Grid.Column="1" x:Name="CodexConfigState" Style="{StaticResource ClientStatusText}"/></Grid></MenuItem.Header>
                  </MenuItem>
                  <MenuItem Style="{StaticResource ClientMenuItem}" Click="Claude_Click">
                    <MenuItem.Icon><Ellipse x:Name="ClaudeConfigDot" Width="9" Height="9" Fill="#94A3B8"/></MenuItem.Icon>
                    <MenuItem.Header><Grid Width="252"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Claude Desktop"/><TextBlock Grid.Column="1" x:Name="ClaudeConfigState" Style="{StaticResource ClientStatusText}"/></Grid></MenuItem.Header>
                  </MenuItem>
                  <MenuItem Style="{StaticResource ClientMenuItem}" Click="Cursor_Click">
                    <MenuItem.Icon><Ellipse x:Name="CursorConfigDot" Width="9" Height="9" Fill="#94A3B8"/></MenuItem.Icon>
                    <MenuItem.Header><Grid Width="252"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Cursor"/><TextBlock Grid.Column="1" x:Name="CursorConfigState" Style="{StaticResource ClientStatusText}"/></Grid></MenuItem.Header>
                  </MenuItem>
                  <MenuItem Style="{StaticResource ClientMenuItem}" Click="Antigravity_Click">
                    <MenuItem.Icon><Ellipse x:Name="AntigravityConfigDot" Width="9" Height="9" Fill="#94A3B8"/></MenuItem.Icon>
                    <MenuItem.Header><Grid Width="252"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Google Antigravity"/><TextBlock Grid.Column="1" x:Name="AntigravityConfigState" Style="{StaticResource ClientStatusText}"/></Grid></MenuItem.Header>
                  </MenuItem>
                  <MenuItem Style="{StaticResource ClientMenuItem}" Click="Kimi_Click">
                    <MenuItem.Icon><Ellipse x:Name="KimiConfigDot" Width="9" Height="9" Fill="#94A3B8"/></MenuItem.Icon>
                    <MenuItem.Header><Grid Width="252"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Kimi Code"/><TextBlock Grid.Column="1" x:Name="KimiConfigState" Style="{StaticResource ClientStatusText}"/></Grid></MenuItem.Header>
                  </MenuItem>
                  <MenuItem Style="{StaticResource ClientMenuItem}" Click="WorkBuddy_Click">
                    <MenuItem.Icon><Ellipse x:Name="WorkBuddyConfigDot" Width="9" Height="9" Fill="#94A3B8"/></MenuItem.Icon>
                    <MenuItem.Header><Grid Width="252"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="WorkBuddy"/><TextBlock Grid.Column="1" x:Name="WorkBuddyConfigState" Style="{StaticResource ClientStatusText}"/></Grid></MenuItem.Header>
                  </MenuItem>
                  <MenuItem Style="{StaticResource ClientMenuItem}" Click="VsCode_Click">
                    <MenuItem.Icon><Ellipse x:Name="VsCodeConfigDot" Width="9" Height="9" Fill="#94A3B8"/></MenuItem.Icon>
                    <MenuItem.Header><Grid Width="252"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="VS Code / Copilot"/><TextBlock Grid.Column="1" x:Name="VsCodeConfigState" Style="{StaticResource ClientStatusText}"/></Grid></MenuItem.Header>
                  </MenuItem>
                  <Separator Margin="8,5" Background="#E2E8F0"/>
                  <MenuItem Style="{StaticResource ClientMenuItem}" Header="Copy generic HTTP MCP JSON" Click="CopyGenericConfig_Click"/>
                </ContextMenu>
              </Button.ContextMenu>
            </Button>
          </Grid>
        </Border>
        </Grid>
      </Grid>

      <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,14,0,0" MinHeight="96">
        <StackPanel>
          <Grid Margin="0,0,0,7">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Status overview" Style="{StaticResource StatusHeading}" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <ComboBox x:Name="MaterialChoice" Width="112" Height="32" Margin="0,0,10,0" SelectedIndex="0"
                        AutomationProperties.Name="Window material" SelectionChanged="MaterialChoice_SelectionChanged"
                        ToolTip="Choose a window material. Native Mica and Acrylic require Windows 11 22H2 or later.">
                <ComboBoxItem Tag="mica">Mica</ComboBoxItem>
                <ComboBoxItem Tag="acrylic">Acrylic</ComboBoxItem>
                <ComboBoxItem Tag="solid">Solid</ComboBoxItem>
              </ComboBox>
              <Button Content="Logs" Style="{StaticResource SmallButton}" Margin="0,0,7,0" Click="OpenLogs_Click"/>
              <Button Content="Updates" Style="{StaticResource SmallButton}" Margin="0,0,7,0" Click="Update_Click"/>
              <Button Content="Copy diagnostics" Style="{StaticResource SmallButton}" Click="CopyDiagnostics_Click"/>
            </StackPanel>
          </Grid>
          <TextBlock x:Name="ConnectionSummary" Text="Checking status automatically…" TextWrapping="Wrap"
                     TextTrimming="CharacterEllipsis" Height="36" ToolTip="{Binding Text, ElementName=ConnectionSummary}"
                     Foreground="{StaticResource BodyBrush}" FontSize="13" LineHeight="18"/>
          <TextBox x:Name="Status" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                   Height="44" Margin="0,8,0,0" Padding="10,6" Background="#F5F5F7" Foreground="#6E6E73"
                   BorderBrush="#E8E8ED" BorderThickness="1" FontFamily="Consolas" FontSize="12"/>
        </StackPanel>
      </Border>
    </Grid>
  </ScrollViewer>
</Window>
